# Copy to .env and adjust for your machine.

# Async PostgreSQL connection string (note the +asyncpg driver).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/glamira

# JWT signing — generate a real secret for anything but local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Base URL the password-reset link points at (a deep link or web page).
RESET_LINK_BASE_URL=https://glamira.app/reset-password

# Google OAuth "Web application" client id (used to verify the app's ID token).
GOOGLE_CLIENT_ID=

# Comma-separated origins allowed to call the API (Flutter web dev server, etc).
# "*" is fine for local development.
CORS_ORIGINS=*

# Optional SMTP for real reset emails. If unset, the reset link is logged to the
# server console instead of being emailed (handy for local testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@glamira.app
